#include "resources/resource.h"
#include "winres.h"

// ExplorerPatcher++: Turkish strings of the "Essential Tweaks" page. They live here instead of the
// ExplorerPatcher-L10N submodule; the IDs are in string table blocks of their own, so they do not collide with it.
